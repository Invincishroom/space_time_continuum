            "show_interpolation": true, 
            "show_covariances": true, 
            "show_frames": true
        },
        "measurements": {
            "vicon": {
                "show": true, 
                "count": 5, 
                "size": 2
            },
            "aurora": {
                "show": true, 
                "count": 2, 
                "size": 2
            }
        },
        "show_ground_plane": true,
        "cameras": [{
            "position": [0, 1, 0.233],
            "look_at": [0, 0, 0.233],
            "up": [0, 0, -1]
        }]
    }
