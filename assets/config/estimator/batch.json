{
    "options": {
        "estimator": "batch", 
        "log": 2,  
        "interpolate_measurements": true, 
        "compute_covariances": true
    },
    "optimizer": {
        "convergence_threshold": 1e-1, 
        "max_iterations": 13,
        "line_search": false, 
