{
    "max_iterations": 2000,
    "learning_rate": 5e-2,
    "use_adam": false,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_epsilon": 1e-8,
    "tol_grad": 1e-5,
    "tol_loss": 1e-5,
    "use_exponential_param": true,
    "freeze_p0_non_pose": false,
    "use_joint_validation_objective": true,
    "log_joint_diagnostics": true,
    "verbose": true,
    "enable_gradient_fd_check": true,
    "gradient_fd_epsilon": 1e-6,
    "gradient_fd_use_lambda_perturbation": true,
    "max_gradient_update_norm": 1e4,
    "max_psi_step_norm": 1e0,
    "min_theta": 1e-12,
    "enable_unary_factor_fd_check": true,
    "enable_time_factor_fd_check": true,
    "enable_space_factor_fd_check": false
}